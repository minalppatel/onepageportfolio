{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/(css|js|images|fonts|webfonts|favicon.svg|robots.txt)(.*)",
      "destination": "/public/$1$2"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ]
}
